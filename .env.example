# ═══════════════════════════════════════
# ProPlumb USA — Environment Variables
# ═══════════════════════════════════════

# Frontend
VITE_API_URL=http://localhost:3001/api
VITE_GOOGLE_MAPS_API_KEY=
VITE_GA_MEASUREMENT_ID=
VITE_SITE_URL=http://localhost:5173

# Backend
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://plumb_user:plumb_password@localhost:5432/plumbingpro
REDIS_URL=redis://:redis_password@localhost:6379

# JWT (RS256 Asymmetric)
JWT_PRIVATE_KEY_PATH=./keys/private.key
JWT_PUBLIC_KEY_PATH=./keys/public.key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
FRONTEND_URL=http://localhost:5173

# CSRF
CSRF_SECRET=change-me-to-a-random-secret

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ProPlumb USA <noreply@proplumb.com>"

# Argon2
ARGON2_SECRET=change-me-to-a-random-argon2-secret

# Docker
DB_PASSWORD=plumb_password
REDIS_PASSWORD=redis_password

# S3 / Object Storage (for file uploads)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
